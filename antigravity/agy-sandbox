#!/usr/bin/env bash
# agy-sandbox — run Antigravity CLI (agy) for the current project in a microsandbox microVM.
#
# Per project (optional), in <project>/.agy-sandbox/:
#   setup.sh  runs as root INSIDE the VM on first boot — install the project's toolchain there.
#             If it installs Docker (dockerd), Docker is started automatically on every boot.
#   ports     one port per line ("3000", or "8080:80" for host:guest), forwarded to localhost.
#
# Usage (from the project root):
#   agy-sandbox           create/start the sandbox and open agy
#   agy-sandbox shell     open a shell instead
#   agy-sandbox setup     re-run .agy-sandbox/setup.sh after editing it, then restart
#   agy-sandbox destroy   remove the sandbox (login and all data inside it)
#
# Resources (optional overrides): CPUS=3 MAX_CPUS=4 MEMORY=4G MAX_MEMORY=8G DISK=30G
set -euo pipefail

NAME="${NAME:-agy-$(basename "$PWD")}"
CFG="$PWD/.agy-sandbox"

START_SCRIPT='
set -e
rm -f /opt/.ready
export DEBIAN_FRONTEND=noninteractive
if [ ! -f /opt/.provisioned ]; then
  apt-get update
  apt-get install -y --no-install-recommends ca-certificates curl git unzip bash \
    dbus dbus-x11 gnome-keyring
  curl -fsSL https://antigravity.google/cli/install.sh | bash
  if [ -f /workspace/.agy-sandbox/setup.sh ]; then
    echo "=== running /workspace/.agy-sandbox/setup.sh ==="
    bash -e /workspace/.agy-sandbox/setup.sh
  fi
  touch /opt/.provisioned
fi

# Keyring where agy stores its Google login (headless Secret Service over D-Bus).
mkdir -p /run/user/0 && chmod 700 /run/user/0 && rm -f /run/user/0/bus
dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork --nopidfile
printf %s "$KEYRING_PASSWORD" | gnome-keyring-daemon --daemonize --unlock --components=secrets >/dev/null

# Docker, only if the project setup installed it.
if command -v dockerd >/dev/null 2>&1; then
  dockerd >/var/log/dockerd.log 2>&1 &
  timeout 90 sh -c "until docker info >/dev/null 2>&1; do sleep 1; done" \
    || { cat /var/log/dockerd.log; docker info; exit 1; }
fi

touch /opt/.ready
exec sleep infinity
'

exists()  { msb ls -q | grep -qx "$NAME"; }
running() { msb ls -q --running | grep -qx "$NAME"; }

wait_ready() {
  echo "Waiting for sandbox (first run installs tools; live log: msb logs -f $NAME)..."
  for i in $(seq 1 450); do   # up to 15 minutes
    if ! running; then
      echo "Sandbox stopped during startup. Last log lines:"; msb logs "$NAME" --tail 60 --source all; exit 1
    fi
    if msb exec --no-stdin -q "$NAME" -- test -f /opt/.ready 2>/dev/null; then return 0; fi
    sleep 2
  done
  echo "Timed out. Last log lines:"; msb logs "$NAME" --tail 60 --source all; exit 1
}

create() {
  # Ports come from a plain list, validated here; nothing from the project is executed on the host.
  local port_flags=() p
  if [ -f "$CFG/ports" ]; then
    while IFS= read -r p || [ -n "$p" ]; do
      p="${p%%#*}"; p="${p//[[:space:]]/}"
      [ -z "$p" ] && continue
      [[ "$p" =~ ^[0-9]+(:[0-9]+)?$ ]] || { echo "Invalid line in .agy-sandbox/ports: $p"; exit 1; }
      [[ "$p" == *:* ]] || p="$p:$p"
      port_flags+=(-p "$p")
    done < "$CFG/ports"
  fi

  msb run -d --name "$NAME" \
    --cpus "${CPUS:-3}" --max-cpus "${MAX_CPUS:-4}" \
    --memory "${MEMORY:-4G}" --max-memory "${MAX_MEMORY:-8G}" \
    --root-disk "flat:${DISK:-30G}" \
    --mount-dir "$PWD:/workspace:rw" --workdir /workspace \
    -e "PATH=/root/.local/bin:/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    -e XDG_RUNTIME_DIR=/run/user/0 \
    -e DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus \
    -e "KEYRING_PASSWORD=$(openssl rand -hex 16)" \
    ${port_flags[@]+"${port_flags[@]}"} \
    --script start="$START_SCRIPT" --entrypoint start \
    debian:trixie-slim
}

usage() {
  cat <<'EOF'
agy-sandbox — run Antigravity CLI (agy) for the current project in a microsandbox microVM.

Usage (from the project root):
  agy-sandbox             create/start the sandbox and open agy
  agy-sandbox shell       open a shell in the sandbox
  agy-sandbox setup       re-run .agy-sandbox/setup.sh, then restart
  agy-sandbox destroy     remove the sandbox (login and all data inside it)
  agy-sandbox -h, --help  show this help

Per-project config (optional), in .agy-sandbox/:
  setup.sh   runs as root in the VM on first boot; install the toolchain here
  ports      one port per line ("3000" or "8080:80"), forwarded to localhost

Environment overrides:
  NAME=agy-<dir>  CPUS=3  MAX_CPUS=4  MEMORY=4G  MAX_MEMORY=8G  DISK=30G
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  destroy) msb rm -f "$NAME"; exit 0 ;;
  setup)
    [ -f "$CFG/setup.sh" ] || { echo "No .agy-sandbox/setup.sh in this project."; exit 1; }
    running || msb start "$NAME"
    msb exec -t -e DEBIAN_FRONTEND=noninteractive "$NAME" -- bash -e /workspace/.agy-sandbox/setup.sh
    msb restart "$NAME"
    wait_ready
    exit 0 ;;
  ""|shell) ;;
  *) usage >&2; exit 1 ;;
esac

if ! exists; then create; elif ! running; then msb start "$NAME"; fi
wait_ready

# SSH_* vars make agy use its "open this URL, paste the code" sign-in instead of launching a browser.
CMD=agy; [ "${1:-}" = shell ] && CMD=bash
exec msb exec -t -e "SSH_CONNECTION=127.0.0.1 22 127.0.0.1 22" -e "SSH_CLIENT=127.0.0.1 22 22" "$NAME" -- "$CMD"
