#!/usr/bin/env bash
# sbxag — one microsandbox microVM per project, with AI coding agents inside.
#
# The project's dev environment (Docker, databases, toolchains) is built once per project.
# Agents (agy, claude) are lightweight and all live in the same VM, so switching agents
# never duplicates the environment. Agent logins are kept in named volumes shared by all
# project sandboxes: sign in once per agent, use it everywhere.
#
# Shells and agents run as a guest user named after the host user, with the same uid/gid and
# passwordless sudo: some tools refuse to run as root (e.g. claude --dangerously-skip-permissions).
#
# Per project (optional), in <project>/.sbxag/:
#   setup.sh  runs as root INSIDE the VM on first run — install the project's toolchain there,
#             system-wide (e.g. /usr/local) so the guest user can run it.
#             If it installs Docker (dockerd), Docker is started automatically on every launch.
#   ports     one port per line ("3000", or "8080:80" for host:guest), forwarded to localhost.
#             Use --host to make them reachable from other machines. Ports are fixed when the
#             sandbox is created: after changing them, run `sbxag destroy` and start again.
#
# Run `sbxag -h` for usage.
set -euo pipefail

NAME="${NAME:-sbxag-$(basename "$PWD")}"
CFG="$PWD/.sbxag"
WORKDIR="/workspace/$(basename "$PWD")"   # where the project is mounted inside the VM

# Guest user: the host user's name (made a valid Linux name), uid and gid. A root host user
# gets a regular "sbxag" user instead, since the point is not to run as root.
if [ "$(id -u)" -eq 0 ]; then
  SBX_USER=sbxag SBX_UID=1000 SBX_GID=1000
else
  SBX_USER="$(id -un | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' '_')"
  [[ "$SBX_USER" =~ ^[a-z_] ]] || SBX_USER="u$SBX_USER"
  SBX_USER="${SBX_USER:0:32}" SBX_UID="$(id -u)" SBX_GID="$(id -g)"
fi
SBX_HOME="/home/$SBX_USER"
# Files on the mounts below appear owned by the guest user (guest view only: host files keep
# their owner).
OWNER="uid=$SBX_UID,gid=$SBX_GID"

# Shared, cross-project volumes holding agent logins.
VOL_CLAUDE="${VOL_CLAUDE:-sbxag-claude}"       # Claude Code config + credentials (CLAUDE_CONFIG_DIR)
VOL_KEYRING="${VOL_KEYRING:-sbxag-keyring}"    # gnome-keyring files, where agy keeps its Google login
KEYRING_DIR="$SBX_HOME/.local/share/keyrings"

# Flags for commands that run as the guest user rather than root.
AS_USER=(--user "$SBX_USER" -e "HOME=$SBX_HOME" -e "USER=$SBX_USER" -e "LOGNAME=$SBX_USER")

# Provisioning: runs once per project sandbox, as root, the first time it is created.
PROVISION='
set -e
apt-get update
apt-get install -y --no-install-recommends ca-certificates curl git unzip bash procps openssl \
  dbus dbus-x11 gnome-keyring sudo
echo "=== creating user $SBX_USER ($SBX_UID:$SBX_GID) ==="
if ! id -u "$SBX_USER" >/dev/null 2>&1; then
  getent group "$SBX_GID" >/dev/null || groupadd -g "$SBX_GID" "$SBX_USER"
  # The home already exists: the login volumes are mounted inside it.
  useradd -M -d "$SBX_HOME" -u "$SBX_UID" -g "$SBX_GID" -s /bin/bash "$SBX_USER"
fi
cp -r /etc/skel/. "$SBX_HOME"/
chown -R "$SBX_UID:$SBX_GID" "$SBX_HOME"   # including logins saved by older, root-only versions
echo "$SBX_USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/sbxag && chmod 0440 /etc/sudoers.d/sbxag
as_user() { runuser -u "$SBX_USER" -- env HOME="$SBX_HOME" USER="$SBX_USER" bash -c "$1"; }
echo "=== installing Antigravity CLI (agy) ==="
as_user "curl -fsSL https://antigravity.google/cli/install.sh | bash"
echo "=== installing Claude Code ==="
as_user "curl -fsSL https://claude.ai/install.sh | bash"
if [ -f "$WORKDIR/.sbxag/setup.sh" ]; then
  echo "=== running $WORKDIR/.sbxag/setup.sh ==="
  bash -e "$WORKDIR/.sbxag/setup.sh"
fi
touch /opt/.provisioned
'

# Services: run on every launch (microsandbox does not re-run anything when a stopped sandbox
# starts again). Idempotent: only starts what is not already running. Daemons are detached
# with setsid so they outlive this exec. The root part runs first, then the user part.
SERVICES_ROOT='
set -e
mkdir -p "$XDG_RUNTIME_DIR"
chown "$SBX_UID:$SBX_GID" "$XDG_RUNTIME_DIR" && chmod 700 "$XDG_RUNTIME_DIR"
# Docker, only if the project setup installed it. The socket belongs to the primary group of
# the user, so the user can reach it without supplementary groups.
if command -v dockerd >/dev/null 2>&1 && ! docker info >/dev/null 2>&1; then
  # /run survives a stop/start here, so clear pid files and sockets left by the previous boot.
  rm -f /var/run/docker.pid /var/run/docker.sock /var/run/docker/containerd/containerd.pid
  setsid -f dockerd --group "$(getent group "$SBX_GID" | cut -d: -f1)" \
    >/var/log/dockerd.log 2>&1 </dev/null
  timeout 180 sh -c "until docker info >/dev/null 2>&1; do sleep 1; done" \
    || { tail -50 /var/log/dockerd.log; docker info; exit 1; }
fi
'
SERVICES_USER='
set -e
names() { dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply \
            / org.freedesktop.DBus.ListNames 2>/dev/null; }
# D-Bus session + unlocked keyring (agy stores its login there). The keyring lives on a volume
# shared by all project sandboxes, so its password is kept next to it, in that same volume.
if ! names >/dev/null; then
  rm -f "$XDG_RUNTIME_DIR/bus"
  dbus-daemon --session --address="$DBUS_SESSION_BUS_ADDRESS" --fork --nopidfile
fi
if ! names | grep -q org.freedesktop.secrets; then
  pw="$KEYRING_DIR/.sbxag-password"
  [ -s "$pw" ] || { (umask 077; openssl rand -hex 16 > "$pw"); }
  gnome-keyring-daemon --daemonize --unlock --components=secrets < "$pw" >/dev/null
fi
'

exists()  { msb ls -q | grep -qx "$NAME"; }
# Distinct host addresses the existing sandbox's ports are bound to (fixed at creation).
bound_ips() {
  msb inspect "$NAME" --format json 2>/dev/null \
    | grep -oE '"host_bind" *: *"[^"]*"' | sed -E 's/.*"([^"]*)"$/\1/' | sort -u
  return 0   # no ports is not an error (grep finding nothing would abort the script under pipefail)
}
is_loopback() { [[ "$1" == 127.* ]]; }
valid_ipv4() {
  local IFS=. o; local -a parts
  [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  read -ra parts <<< "$1"
  for o in "${parts[@]}"; do (( 10#$o <= 255 )) || return 1; done
}
running() { msb ls -q --running | grep -qx "$NAME"; }

create() {
  # Ports come from a plain list, validated here; nothing from the project is executed on the host.
  local port_flags=() p
  if [ -f "$CFG/ports" ]; then
    while IFS= read -r p || [ -n "$p" ]; do
      p="${p%%#*}"; p="${p//[[:space:]]/}"
      [ -z "$p" ] && continue
      [[ "$p" =~ ^[0-9]+(:[0-9]+)?$ ]] || { echo "Invalid line in .sbxag/ports: $p" >&2; exit 1; }
      [[ "$p" == *:* ]] || p="$p:$p"
      port_flags+=(-p "$HOST_BIND:$p")
    done < "$CFG/ports"
  fi

  msb create --name "$NAME" \
    --cpus "${CPUS:-3}" --max-cpus "${MAX_CPUS:-4}" \
    --memory "${MEMORY:-4G}" --max-memory "${MAX_MEMORY:-8G}" \
    --root-disk "flat:${DISK:-30G}" \
    --mount-dir "$PWD:$WORKDIR:rw,$OWNER" --workdir "$WORKDIR" \
    --mount-named "$VOL_CLAUDE:$SBX_HOME/.claude:$OWNER" \
    --mount-named "$VOL_KEYRING:$KEYRING_DIR:$OWNER" \
    -e "PATH=$SBX_HOME/.local/bin:$SBX_HOME/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    -e DEBIAN_FRONTEND=noninteractive \
    -e CLAUDE_CONFIG_DIR="$SBX_HOME/.claude" \
    -e KEYRING_DIR="$KEYRING_DIR" \
    -e WORKDIR="$WORKDIR" \
    -e SBX_USER="$SBX_USER" -e SBX_UID="$SBX_UID" -e SBX_GID="$SBX_GID" -e SBX_HOME="$SBX_HOME" \
    -e XDG_RUNTIME_DIR="/run/user/$SBX_UID" \
    -e DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$SBX_UID/bus" \
    ${port_flags[@]+"${port_flags[@]}"} \
    debian:trixie-slim

  if [ ${#port_flags[@]} -gt 0 ] && ! is_loopback "$HOST_BIND"; then
    echo "Warning: ports are bound to $HOST_BIND and reachable from other machines on your network:" \
      "$(printf '%s ' "${port_flags[@]}" | sed 's/-p //g')" >&2
  fi
}

# Bring the sandbox to a usable state: create or start it, provision once, start services.
up() {
  if ! exists; then
    create
  else
    local ips ip exposed=
    ips="$(bound_ips)"
    for ip in $ips; do is_loopback "$ip" || exposed+="$ip "; done
    if [ -n "$HOST_SET" ] && [ -n "$ips" ] && [ "$ips" != "$HOST_BIND" ]; then
      echo "Note: $NAME already exists with ports bound to $(echo $ips); --host only applies at creation." \
        "Run 'sbxag destroy' to re-create it bound to $HOST_BIND." >&2
    elif [ -z "$HOST_SET" ] && [ -n "$exposed" ]; then
      echo "Note: $NAME's ports are bound to ${exposed% } and reachable from your network." \
        "To restrict them to localhost: sbxag destroy, then sbxag." >&2
    fi
    running || msb start "$NAME"
  fi
  local state
  state="$(msb exec --no-stdin -q -e "SBX_USER=$SBX_USER" "$NAME" -- bash -c \
    'if [ ! -f /opt/.provisioned ]; then echo new; elif id -u "$SBX_USER" >/dev/null 2>&1; then echo ok; else echo old; fi')"
  case "$state" in
    new)
      echo "First run: installing agents and project tools (a few minutes)..."
      msb exec --no-stdin "$NAME" -- bash -c "$PROVISION" ;;
    old)
      echo "$NAME was created by an older sbxag that runs everything as root." \
        "Run 'sbxag destroy' and start again; your agent logins are kept (they're in shared volumes)." >&2
      exit 1 ;;
  esac
  msb exec --no-stdin -q "$NAME" -- bash -c "$SERVICES_ROOT"
  msb exec --no-stdin -q "${AS_USER[@]}" "$NAME" -- bash -c "$SERVICES_USER"
}

usage() {
  cat <<'EOF'
sbxag — one microsandbox microVM per project, with AI coding agents inside.

Usage (from the project root):
  sbxag [--host [IP]] [COMMAND]
  sbxag                 open a shell in the project's sandbox (as you; sudo works)
  sbxag agy [ARGS]      run Antigravity CLI
  sbxag claude [ARGS]   run Claude Code
  sbxag setup           re-run .sbxag/setup.sh
  sbxag stop            stop the sandbox (keeps tools, data and logins)
  sbxag destroy         remove the project's sandbox (logins are kept, they're shared)
  sbxag update          update sbxag itself to the latest version
  sbxag -h, --help      show this help

Options:
  --host [IP]           bind forwarded ports to IP instead of 127.0.0.1, like vite's --host;
                        without IP, 0.0.0.0 (reachable from other machines on your network).
                        Applies when the sandbox is created.

Per-project config (optional), in .sbxag/:
  setup.sh   runs as root in the VM on first run; install the toolchain here, system-wide
             (e.g. /usr/local) so the guest user can run it
  ports      one port per line ("3000" or "8080:80"), forwarded to localhost (see --host).
             Fixed at creation: after editing, run `sbxag destroy` and start again.

Agent logins live in shared volumes (sbxag-claude, sbxag-keyring): sign in once per agent,
every project's sandbox uses it. Reset with: msb volume rm sbxag-claude sbxag-keyring

Environment overrides:
  NAME=sbxag-<dir>  CPUS=3  MAX_CPUS=4  MEMORY=4G  MAX_MEMORY=8G  DISK=30G
EOF
}

self_update() {
  local url="https://raw.githubusercontent.com/singh-ramanpreet/sandboxed-agents/${REF:-main}/sbxag"
  local self tmp
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  tmp="$(mktemp "${self}.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  curl -fsSL "$url" -o "$tmp"
  head -n1 "$tmp" | grep -q '^#!/usr/bin/env bash' && bash -n "$tmp" \
    || { echo "Download doesn't look like a valid sbxag: $url" >&2; exit 1; }
  if cmp -s "$tmp" "$self"; then echo "sbxag is already up to date."; exit 0; fi
  chmod 0755 "$tmp"
  mv -f "$tmp" "$self"
  trap - EXIT
  echo "Updated $self"
}

# Leading options (anything after the command is passed through to the agent).
HOST_BIND=127.0.0.1 HOST_SET=
while [ $# -gt 0 ]; do
  case "$1" in
    --host=*) HOST_BIND="${1#--host=}"; HOST_SET=1; shift ;;
    --host)
      HOST_SET=1; shift
      if [[ "${1:-}" =~ ^[0-9.]+$ ]]; then HOST_BIND="$1"; shift; else HOST_BIND=0.0.0.0; fi ;;
    *) break ;;
  esac
done
valid_ipv4 "$HOST_BIND" || { echo "--host: not a valid IPv4 address: $HOST_BIND" >&2; exit 1; }

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  stop|destroy|update)
    [ -n "$HOST_SET" ] && { echo "--host has no effect with '$cmd'; it applies when a sandbox is created." >&2; exit 1; } ;;
esac
case "$cmd" in
  -h|--help) usage; exit 0 ;;
  update) self_update; exit 0 ;;
  stop)
    if running; then msb stop "$NAME"; else echo "$NAME is not running."; fi
    exit 0 ;;
  destroy) msb rm -f "$NAME"; exit 0 ;;
  setup)
    [ -f "$CFG/setup.sh" ] || { echo "No .sbxag/setup.sh in this project." >&2; exit 1; }
    up
    msb exec -t "$NAME" -- bash -e "$WORKDIR/.sbxag/setup.sh"
    msb exec --no-stdin -q "$NAME" -- bash -c "$SERVICES_ROOT"   # e.g. start Docker if setup just installed it
    exit 0 ;;
  "")
    up
    exec msb exec -t "${AS_USER[@]}" "$NAME" -- bash ;;
  agy)
    up
    # SSH_* vars make agy use its "open this URL, paste the code" sign-in instead of a browser.
    exec msb exec -t "${AS_USER[@]}" -e "SSH_CONNECTION=127.0.0.1 22 127.0.0.1 22" -e "SSH_CLIENT=127.0.0.1 22 22" \
      "$NAME" -- agy "$@" ;;
  claude)
    up
    exec msb exec -t "${AS_USER[@]}" "$NAME" -- claude "$@" ;;
  *) usage >&2; exit 1 ;;
esac
