#!/usr/bin/env bash
# sbxag — one microsandbox microVM per project.
#
# Shells run as a guest user named after the host user, with the same uid/gid and
# passwordless sudo: some tools refuse to run as root (e.g. claude --dangerously-skip-permissions).
#
# Per project (optional), in <project>/.sbxag/:
#   config.yml     settings applied when the sandbox is created (cpus, max_cpus, memory,
#                  max_memory, disk, image, ports, volumes, mounts).
#                  After changing config.yml, run `sbxag destroy` and start again.
#   setup.sh       runs as root INSIDE the VM on first run — install system packages,
#                  daemons (e.g. Docker), and system-wide toolchains (/usr/local).
#   setup-user.sh  runs as the guest user right after setup.sh: things that belong in $HOME
#                  (agents like claude/agy, dotfiles, rustup/nvm/uv, project dependencies).
#
# Run `sbxag -h` for usage.
set -euo pipefail

NAME="${NAME:-sbxag-$(basename "$PWD")}"
CFG="$PWD/.sbxag"
WORKDIR="/workspace/$(basename "$PWD")"   # where the project is mounted inside the VM

# Guest user: the host user's name (made a valid Linux name), uid and gid. A root host user
# gets a regular "sbxag" user instead, since the point is not to run as root.
if [ "$(id -u)" -eq 0 ]; then
  SBX_USER=sbxag SBX_UID=1000 SBX_GID=1000
else
  SBX_USER="$(id -un | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' '_')"
  [[ "$SBX_USER" =~ ^[a-z_] ]] || SBX_USER="u$SBX_USER"
  SBX_USER="${SBX_USER:0:32}" SBX_UID="$(id -u)" SBX_GID="$(id -g)"
fi
SBX_HOME="/home/$SBX_USER"
# Files on the mounts below appear owned by the guest user (guest view only: host files keep
# their owner).
OWNER="uid=$SBX_UID,gid=$SBX_GID"

# Flags for commands that run as the guest user rather than root.
AS_USER=(--user "$SBX_USER" -e "HOME=$SBX_HOME" -e "USER=$SBX_USER" -e "LOGNAME=$SBX_USER")

# Provisioning: runs once per project sandbox, as root, the first time it is created.
PROVISION='
set -e
if ! command -v sudo >/dev/null || [ ! -f /etc/ssl/certs/ca-certificates.crt ]; then
  apt-get update
  apt-get install -y --no-install-recommends sudo ca-certificates
fi
echo "=== creating user $SBX_USER ($SBX_UID:$SBX_GID) ==="
if ! id -u "$SBX_USER" >/dev/null 2>&1; then
  getent group "$SBX_GID" >/dev/null || groupadd -g "$SBX_GID" "$SBX_USER"
  useradd -o -M -d "$SBX_HOME" -u "$SBX_UID" -g "$SBX_GID" -s /bin/bash "$SBX_USER"
fi
mkdir -p "$SBX_HOME"
cp -rn /etc/skel/. "$SBX_HOME"/
find "$SBX_HOME" -xdev ! -exec mountpoint -q {} \; -exec chown "$SBX_UID:$SBX_GID" {} +
echo "$SBX_USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/sbxag && chmod 0440 /etc/sudoers.d/sbxag
as_user() { runuser -u "$SBX_USER" -- env HOME="$SBX_HOME" USER="$SBX_USER" LOGNAME="$SBX_USER" "$@"; }
if [ -f "$WORKDIR/.sbxag/setup.sh" ]; then
  echo "=== running $WORKDIR/.sbxag/setup.sh ==="
  bash -e "$WORKDIR/.sbxag/setup.sh"
fi
if [ -f "$WORKDIR/.sbxag/setup-user.sh" ]; then
  echo "=== running $WORKDIR/.sbxag/setup-user.sh as $SBX_USER ==="
  (cd "$WORKDIR" && as_user bash -e "$WORKDIR/.sbxag/setup-user.sh")
fi
touch /opt/.provisioned
'

exists()  { msb ls -q | grep -Fxq "$NAME"; }
is_loopback() { [[ "$1" == 127.* ]]; }
valid_ipv4() {
  local IFS=. o; local -a parts
  [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  read -ra parts <<< "$1"
  for o in "${parts[@]}"; do (( 10#$o <= 255 )) || return 1; done
}
valid_port() { [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }
running() { msb ls -q --running | grep -Fxq "$NAME"; }

# Parse .sbxag/config.yml safely without executing anything on the host.
load_config() {
  local line k v list_key=
  cfg_cpus= cfg_max_cpus= cfg_memory= cfg_max_memory= cfg_disk= cfg_image=
  cfg_ports= cfg_volumes= cfg_mounts=
  [ -f "$CFG/config.yml" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%%#*}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "${line//[[:space:]]/}" ]] && continue
    if [[ "$line" =~ ^[[:space:]]*-[[:space:]]+(.*)$ ]]; then
      v="${BASH_REMATCH[1]}"
      if [[ "$v" =~ ^\"(.*)\"$ ]] || [[ "$v" =~ ^\'(.*)\'$ ]]; then v="${BASH_REMATCH[1]}"; fi
      case "$list_key" in
        ports)   cfg_ports+="$v " ;;
        volumes) cfg_volumes+="$v " ;;
        mounts)  cfg_mounts+="$v " ;;
        *) echo "Unexpected list item in .sbxag/config.yml: $line" >&2; exit 1 ;;
      esac
      continue
    fi
    list_key=
    if [[ ! "$line" =~ ^[[:space:]]*([a-zA-Z_]+):[[:space:]]*(.*)$ ]]; then
      echo "Invalid line in .sbxag/config.yml: $line" >&2; exit 1
    fi
    k="${BASH_REMATCH[1],,}" v="${BASH_REMATCH[2]}"
    if [[ "$v" =~ ^\"(.*)\"$ ]] || [[ "$v" =~ ^\'(.*)\'$ ]]; then v="${BASH_REMATCH[1]}"; fi
    case "$k" in
      cpus)       cfg_cpus="$v" ;;
      max_cpus)   cfg_max_cpus="$v" ;;
      memory)     cfg_memory="$v" ;;
      max_memory) cfg_max_memory="$v" ;;
      disk)       cfg_disk="$v" ;;
      image)      cfg_image="$v" ;;
      ports)
        if [ -z "$v" ]; then list_key=ports
        else v="${v#\[}"; v="${v%\]}"; cfg_ports+="${v//,/ } "; fi ;;
      volumes)
        if [ -z "$v" ]; then list_key=volumes
        else v="${v#\[}"; v="${v%\]}"; cfg_volumes+="${v//,/ } "; fi ;;
      mounts)
        if [ -z "$v" ]; then list_key=mounts
        else v="${v#\[}"; v="${v%\]}"; cfg_mounts+="${v//,/ } "; fi ;;
      *) echo "Unknown key in .sbxag/config.yml: $k" >&2; exit 1 ;;
    esac
  done < "$CFG/config.yml"
}

create() {
  load_config
  local cpus="${CPUS:-${cfg_cpus:-3}}"
  local max_cpus="${MAX_CPUS:-${cfg_max_cpus:-4}}"
  local memory="${MEMORY:-${cfg_memory:-4G}}"
  local max_memory="${MAX_MEMORY:-${cfg_max_memory:-8G}}"
  local disk="${DISK:-${cfg_disk:-30G}}"
  local image="${IMAGE:-${cfg_image:-debian:trixie-slim}}"
  local ports_raw="${PORTS:-${cfg_ports:-}}"
  local volumes_raw="${VOLUMES:-${cfg_volumes:-}}"
  local mounts_raw="${MOUNTS:-${cfg_mounts:-}}"

  [[ "$cpus" =~ ^[0-9]+$ ]]            || { echo "Invalid cpus: $cpus" >&2; exit 1; }
  [[ "$max_cpus" =~ ^[0-9]+$ ]]        || { echo "Invalid max_cpus: $max_cpus" >&2; exit 1; }
  [[ "$memory" =~ ^[0-9]+[MGT]?B?$ ]]  || { echo "Invalid memory: $memory" >&2; exit 1; }
  [[ "$max_memory" =~ ^[0-9]+[MGT]?B?$ ]] || { echo "Invalid max_memory: $max_memory" >&2; exit 1; }
  [[ "$disk" =~ ^[0-9]+[MGT]?B?$ ]]    || { echo "Invalid disk: $disk" >&2; exit 1; }
  [[ "$image" =~ ^[a-zA-Z0-9_./:@-]+$ && "$image" != -* ]] || { echo "Invalid image: $image" >&2; exit 1; }

  local port_flags=() exposed=() ports_list=() p ip host_port guest_port
  read -ra ports_list <<< "$ports_raw"
  for p in ${ports_list[@]+"${ports_list[@]}"}; do
    if [[ "$p" =~ ^([0-9.]+):([0-9]+)(:([0-9]+))?$ ]]; then
      ip="${BASH_REMATCH[1]}" host_port="${BASH_REMATCH[2]}" guest_port="${BASH_REMATCH[4]:-${BASH_REMATCH[2]}}"
      valid_ipv4 "$ip" || { echo "Invalid IP in ports: $p" >&2; exit 1; }
    elif [[ "$p" =~ ^([0-9]+)(:([0-9]+))?$ ]]; then
      ip="127.0.0.1" host_port="${BASH_REMATCH[1]}" guest_port="${BASH_REMATCH[3]:-${BASH_REMATCH[1]}}"
    else
      echo "Invalid port in ports: $p" >&2; exit 1
    fi
    valid_port "$host_port" && valid_port "$guest_port" \
      || { echo "Port out of range (1-65535) in ports: $p" >&2; exit 1; }
    port_flags+=(-p "$ip:$host_port:$guest_port")
    is_loopback "$ip" || exposed+=("$ip:$host_port:$guest_port")
  done

  local vol_flags=() volumes_list=() v vol_name guest_path
  read -ra volumes_list <<< "$volumes_raw"
  for v in ${volumes_list[@]+"${volumes_list[@]}"}; do
    if [[ ! "$v" =~ ^([a-zA-Z0-9_.-]+):([a-zA-Z0-9_./-]+)$ ]] || [[ "$v" == *..* ]]; then
      echo "Invalid volume in volumes (expected name:path): $v" >&2; exit 1
    fi
    vol_name="${BASH_REMATCH[1]}" guest_path="${BASH_REMATCH[2]}"
    [[ "$guest_path" == /* ]] || guest_path="$SBX_HOME/$guest_path"
    vol_flags+=(--mount-named "$vol_name:$guest_path:$OWNER")
  done

  local mount_flags=() mounts_list=() m host_path mode
  read -ra mounts_list <<< "$mounts_raw"
  for m in ${mounts_list[@]+"${mounts_list[@]}"}; do
    if [[ ! "$m" =~ ^([^:,]+):([^:,]+)(:(ro|rw))?$ ]]; then
      echo "Invalid mount in mounts (expected host_path:guest_path[:ro|rw]): $m" >&2; exit 1
    fi
    host_path="${BASH_REMATCH[1]}" guest_path="${BASH_REMATCH[2]}" mode="${BASH_REMATCH[4]:-rw}"
    [[ "$host_path" == "~/"* ]] && host_path="$HOME/${host_path#\~/}"
    [[ "$host_path" == /* ]] || host_path="$PWD/${host_path#./}"
    [[ "$guest_path" == "~/"* ]] && guest_path="${guest_path#\~/}"
    [[ "$guest_path" == /* ]] || guest_path="$SBX_HOME/$guest_path"
    if [[ ! "$guest_path" =~ ^/[a-zA-Z0-9_./-]+$ ]] || [[ "$guest_path" == *..* ]]; then
      echo "Invalid guest path in mounts: $m" >&2; exit 1
    fi
    if [ -f "$host_path" ]; then
      mount_flags+=(--mount-file "$host_path:$guest_path:$mode,$OWNER")
    elif [ -d "$host_path" ]; then
      mount_flags+=(--mount-dir "$host_path:$guest_path:$mode,$OWNER")
    else
      echo "Mount source not found (expected file or directory): $host_path" >&2; exit 1
    fi
  done

  # Optional extra flags passed to msb create from the host environment (e.g. MSB_ARGS="--net public,private")
  local msb_args=()
  if [ -n "${MSB_ARGS:-}" ]; then
    eval "msb_args=($MSB_ARGS)"
  fi

  # host-perms=mirror: modes set in the guest (new files, chmod +x) reach the host files too;
  # by default they stay inside the sandbox, which breaks git and executable scripts.
  # Named volumes keep the default: they typically hold credentials/state.
  echo "=== creating sandbox $NAME ($image) ==="
  msb create --name "$NAME" \
    --cpus "$cpus" --max-cpus "$max_cpus" \
    --memory "$memory" --max-memory "$max_memory" \
    --root-disk "flat:$disk" \
    --mount-dir "$PWD:$WORKDIR:rw,$OWNER,host-perms=mirror" --workdir "$WORKDIR" \
    ${vol_flags[@]+"${vol_flags[@]}"} \
    ${mount_flags[@]+"${mount_flags[@]}"} \
    -e "PATH=$SBX_HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    -e DEBIAN_FRONTEND=noninteractive \
    -e WORKDIR="$WORKDIR" \
    -e SBX_USER="$SBX_USER" -e SBX_UID="$SBX_UID" -e SBX_GID="$SBX_GID" -e SBX_HOME="$SBX_HOME" \
    ${port_flags[@]+"${port_flags[@]}"} \
    ${msb_args[@]+"${msb_args[@]}"} \
    "$image"

  if [ ${#exposed[@]} -gt 0 ]; then
    echo "Warning: ports reachable from other machines on your network: ${exposed[*]}" >&2
  fi
}

# Bring the sandbox to a usable state: create or start it, provision once.
PROVISIONED_NOW=
up() {
  if ! exists; then
    create
  else
    running || msb start "$NAME"
  fi
  local state
  state="$(msb exec --no-stdin -q -e "SBX_USER=$SBX_USER" "$NAME" -- bash -c \
    'if [ ! -f /opt/.provisioned ]; then echo new; elif id -u "$SBX_USER" >/dev/null 2>&1; then echo ok; else echo old; fi')"
  case "$state" in
    new)
      echo "=== first run: provisioning sandbox ==="
      local tty_flag=(--no-stdin); [ -t 0 ] && tty_flag=(-t)
      msb exec "${tty_flag[@]}" "$NAME" -- bash -c "$PROVISION"
      PROVISIONED_NOW=1 ;;
    old)
      echo "$NAME was created by an older sbxag that runs everything as root." \
        "Run 'sbxag destroy' and start again." >&2
      exit 1 ;;
  esac
}

usage() {
  cat <<'EOF'
sbxag — one microsandbox microVM per project.

Usage (from the project root):
  sbxag                 open a shell in the project's sandbox (as you; sudo works)
  sbxag setup           re-run .sbxag/setup.sh, then .sbxag/setup-user.sh
  sbxag stop            stop the sandbox (keeps tools, data and volumes)
  sbxag destroy         remove the project's sandbox (named volumes are kept)
  sbxag update          update sbxag itself to the latest version
  sbxag -h, --help      show this help

Per-project config (optional), in .sbxag/:
  config.yml     settings applied at creation (after editing, run `sbxag destroy`):
                   cpus: 3
                   max_cpus: 4
                   memory: 4G
                   max_memory: 8G
                   disk: 30G
                   image: debian:trixie-slim   # or mcr.microsoft.com/devcontainers/base:trixie for faster first boot
                   volumes:
                     - sbxag-claude:.claude
                     - sbxag-agy:.gemini
                   mounts:
                     - ~/.gitconfig:.gitconfig:ro
                   ports:
                     - 3000
                     - 8080:80
                     - 0.0.0.0:5173
  setup.sh       runs as root in the VM on first run; install system packages, daemons, and
                 system-wide toolchains (e.g. /usr/local)
  setup-user.sh  runs as you right after setup.sh, in the project dir; for things that
                 belong in $HOME (coding agents, dotfiles, rustup/nvm/uv, project deps)

Environment overrides (take precedence over .sbxag/config.yml):
  NAME=sbxag-<dir>  CPUS  MAX_CPUS  MEMORY  MAX_MEMORY  DISK  IMAGE  PORTS  VOLUMES  MOUNTS
  MSB_ARGS="..."    extra arguments passed to msb create (e.g. MSB_ARGS="--net public,private")
EOF
}

self_update() {
  local url="https://raw.githubusercontent.com/singh-ramanpreet/sandboxed-agents/${REF:-main}/sbxag"
  local self tmp
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  tmp="$(mktemp "${self}.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  curl -fsSL "$url" -o "$tmp"
  head -n1 "$tmp" | grep -q '^#!/usr/bin/env bash' && bash -n "$tmp" \
    || { echo "Download doesn't look like a valid sbxag: $url" >&2; exit 1; }
  if cmp -s "$tmp" "$self"; then echo "sbxag is already up to date."; exit 0; fi
  chmod 0755 "$tmp"
  mv -f "$tmp" "$self"
  trap - EXIT
  echo "Updated $self"
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  -h|--help) usage; exit 0 ;;
  update) self_update; exit 0 ;;
  stop)
    if running; then msb stop "$NAME"; else echo "$NAME is not running."; fi
    exit 0 ;;
  destroy) msb rm -f "$NAME"; exit 0 ;;
  setup)
    [ -f "$CFG/setup.sh" ] || [ -f "$CFG/setup-user.sh" ] \
      || { echo "No .sbxag/setup.sh or .sbxag/setup-user.sh in this project." >&2; exit 1; }
    up
    [ -n "$PROVISIONED_NOW" ] && exit 0
    if [ -f "$CFG/setup.sh" ]; then
      msb exec -t "$NAME" -- bash -e "$WORKDIR/.sbxag/setup.sh"
    fi
    if [ -f "$CFG/setup-user.sh" ]; then
      msb exec -t "${AS_USER[@]}" "$NAME" -- bash -e "$WORKDIR/.sbxag/setup-user.sh"
    fi
    exit 0 ;;
  "")
    up
    exec msb exec -t "${AS_USER[@]}" "$NAME" -- bash ;;
  *) usage >&2; exit 1 ;;
esac
